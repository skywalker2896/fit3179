{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Expected vs Actual Exit Round (Australian Open 2024)",
    "fontSize": 14,
    "anchor": "start"
  },
  "description": "Each player's seed-based expected exit round (per the tournament seeding convention) plotted against their actual exit round in the 2024 Australian Open. Colour shows the number of players in each intersection, faceted by Men's and Women's Singles.",
  "data": {
    "url": "https://raw.githubusercontent.com/skywalker2896/fit3179/refs/heads/main/dataset/chart5.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "SelectedEvent",
      "value": "Men's Singles",
      "bind": {
        "input": "select",
        "options": [
          "Men's Singles",
          "Women's Singles"
        ],
        "name": "Draw: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.event === SelectedEvent"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "num_players"
        }
      ],
      "groupby": [
        "expected_round",
        "actual_round"
      ]
    }
  ],
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "expected_round",
          "type": "ordinal",
          "title": "Expected exit round (by seed)",
          "sort": [
            "SF",
            "QF",
            "R16",
            "R32",
            "R1/R2"
          ],
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "actual_round",
          "type": "ordinal",
          "title": "Actual exit round",
          "sort": [
            "Won",
            "F",
            "SF",
            "QF",
            "R16",
            "R32",
            "R1/R2"
          ]
        },
        "color": {
          "field": "num_players",
          "type": "quantitative",
          "title": "Number of players",
          "scale": {
            "scheme": "blues"
          }
        },
        "tooltip": [
          {
            "field": "expected_round",
            "type": "ordinal",
            "title": "Expected exit"
          },
          {
            "field": "actual_round",
            "type": "ordinal",
            "title": "Actual exit"
          },
          {
            "field": "num_players",
            "type": "quantitative",
            "title": "Players"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "expected_round",
          "type": "ordinal",
          "sort": [
            "SF",
            "QF",
            "R16",
            "R32",
            "R1/R2"
          ]
        },
        "y": {
          "field": "actual_round",
          "type": "ordinal",
          "sort": [
            "Won",
            "F",
            "SF",
            "QF",
            "R16",
            "R32",
            "R1/R2"
          ]
        },
        "text": {
          "field": "num_players",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.num_players > 40",
            "value": "white"
          },
          "value": "black"
        }
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 10,
      "titleFontSize": 12
    },
    "title": {
      "fontSize": 16
    }
  }
}