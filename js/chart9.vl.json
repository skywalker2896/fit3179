{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/skywalker2896/fit3179/refs/heads/main/dataset/chart9.csv"
  },
  "width": "container",
  "height": 260,
  "params": [
    {
      "name": "roundIdx",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 7,
        "step": 1,
        "name": "Round (0 = all, 1–7 = first round → Final): "
      }
    }
  ],
  "transform": [
    {
      "filter": "roundIdx === 0 || datum.round === [\"Round 1\", \"Round 2\", \"Round 3\", \"Round of 16\", \"Quarter-final\", \"Semi-final\", \"Final\"][roundIdx-1]"
    },
    {
      "density": "games",
      "groupby": [
        "round",
        "tour"
      ],
      "bandwidth": 2.5,
      "extent": [
        8,
        85
      ],
      "steps": 155,
      "as": [
        "games",
        "density"
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false
    }
  },
  "encoding": {
    "x": {
      "field": "games",
      "type": "quantitative",
      "title": "Total games in match",
      "scale": {
        "domain": [
          8,
          85
        ]
      },
      "axis": {
        "values": [
          10,
          20,
          30,
          40,
          50,
          60,
          70,
          80
        ],
        "grid": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "fillOpacity": 0.55,
        "line": {
          "strokeWidth": 1.5
        }
      },
      "encoding": {
        "y": {
          "field": "density",
          "type": "quantitative",
          "title": "Share of matches (density)",
          "scale": {
            "domain": [
              0,
              0.095
            ]
          },
          "axis": {
            "labels": false,
            "ticks": false
          },
          "stack": null
        },
        "color": {
          "field": "tour",
          "type": "nominal",
          "title": "Tour",
          "scale": {
            "domain": [
              "Men",
              "Women"
            ],
            "range": [
              "#2171b5",
              "#e6550d"
            ]
          },
          "legend": {
            "orient": "top-right"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "param": "hover",
            "empty": false
          }
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#888",
        "strokeDash": [
          4,
          3
        ]
      }
    },
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "games"
            ],
            "nearest": true,
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "density",
          "type": "quantitative"
        },
        "color": {
          "field": "tour",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Men",
              "Women"
            ],
            "range": [
              "#2171b5",
              "#e6550d"
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "tour",
            "title": "Tour"
          },
          {
            "field": "games",
            "type": "quantitative",
            "title": "Total games",
            "format": ".0f"
          },
          {
            "field": "density",
            "type": "quantitative",
            "title": "Share of matches at this game count",
            "format": ".1%"
          }
        ]
      }
    }
  ]
}