{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "C2. Australian Open Total Attendance, 2000-2025",
    "subtitle": ["2021–2022 dips reflect COVID-19 crowd capacity restrictions", "Source: The Sporting News / Yahoo Sports, scraped Feb 2026"]
  },
  "data": {
    "url": "https://raw.githubusercontent.com/skywalker2896/fit3179/refs/heads/main/dataset/chart2.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {"calculate": "toNumber(datum.attendance)", "as": "attendance"},
    {"calculate": "toNumber(datum.year)", "as": "year"}
  ],
  "layer": [
    {
      "mark": {"type": "line", "color": "#0c2b5e", "point": {"filled": true, "size": 40}},
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "title": "Year", "axis": {"labelAngle": -45}},
        "y": {"field": "attendance", "type": "quantitative", "title": "Total attendance", "axis": {"format": "~s"}},
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "attendance", "type": "quantitative", "title": "Attendance", "format": ","},
          {"field": "note", "type": "nominal", "title": "Note"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.note && datum.note !== ''"}],
      "mark": {"type": "point", "shape": "circle", "filled": true, "size": 90, "color": "#c0392b"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "attendance", "type": "quantitative"},
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "attendance", "type": "quantitative", "title": "Attendance", "format": ","},
          {"field": "note", "type": "nominal", "title": "Note"}
        ]
      }
    }
  ],
  "width": 350,
  "height": 200,
  "config": {
    "view": {"stroke": null},
    "axis": {"domain": false, "ticks": false, "labelFontSize": 11, "titleFontSize": 13, "grid": true, "gridColor": "#e7e2d8"}
  }
}