{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Rank Entering AO vs. 4 Weeks Later (Top 20 Seeds, 2026)","fontSize": 14,
  "anchor": "start","offset": 12
  },
  "description": "Each line tracks one of the top 20 seeded AO 2026 men's players from their ATP ranking entering the tournament (week 2, 2026) to four weeks later (week 6, 2026).",
  "data": {
    "url": "https://raw.githubusercontent.com/skywalker2896/fit3179/refs/heads/main/dataset/chart7.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "toNumber(datum.seed) <= 20"
    },
    {
      "calculate": "toNumber(datum.rank_entering_ao)",
      "as": "rank_enter"
    },
    {
      "calculate": "toNumber(datum.rank_4weeks_later)",
      "as": "rank_later"
    },
    {
      "calculate": "datum.rank_enter > datum.rank_later ? 'Moved up' : (datum.rank_enter < datum.rank_later ? 'Moved down' : 'No change')",
      "as": "movement"
    },
    {
      "fold": [
        "rank_enter",
        "rank_later"
      ],
      "as": [
        "time_point",
        "rank_num"
      ]
    },
    {
      "calculate": "datum.time_point === 'rank_enter' ? 'Entering AO' : '4 weeks later'",
      "as": "time_label"
    }
  ],
  "width": "container",
  "height": 400,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": {
    "left": 150,
    "right": 12,
    "top": 5,
    "bottom": 5
  },
  "encoding": {
    "x": {
      "field": "time_label",
      "type": "ordinal",
      "sort": [
        "Entering AO",
        "4 weeks later"
      ],
      "title": null,
      "scale": {
        "padding": 0.15
      },
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "ticks": false,
        "domain": false,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "rank_num",
      "type": "quantitative",
      "scale": {
        "reverse": true,
        "domain": [
          0,
          23
        ]
      },
      "axis": null
    },
    "color": {
      "field": "movement",
      "type": "nominal",
      "title": "Rank change",
      "scale": {
        "domain": [
          "Moved up",
          "No change",
          "Moved down"
        ],
        "range": [
          "#1f77b4",
          "#9a9a9a",
          "#d62728"
        ]
      },
      "legend": {
        "orient": "right",
        "direction": "vertical",
        "titleFontSize": 10,
        "labelFontSize": 10,
        "symbolSize": 50,
        "padding": 0,
        "offset": 150
      }
    },
    "detail": {
      "field": "player",
      "type": "nominal"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "opacity": 0.85
      },
      "encoding": {
        "tooltip": [
          {
            "field": "player",
            "type": "nominal",
            "title": "Player"
          },
          {
            "field": "seed",
            "type": "quantitative",
            "title": "Seed"
          },
          {
            "field": "time_label",
            "type": "nominal",
            "title": "When"
          },
          {
            "field": "rank_num",
            "type": "quantitative",
            "title": "Rank"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 45,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "field": "movement",
          "type": "nominal",
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.time_label === 'Entering AO'"
        },
        {
          "calculate": "datum.player + '  ' + datum.rank_num",
          "as": "left_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -9,
        "fontSize": 10,
        "color": "#1b1f24"
      },
      "encoding": {
        "text": {
          "field": "left_label"
        },
        "color": {
          "value": "#1b1f24"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.time_label === '4 weeks later'"
        },
        {
          "calculate": "datum.rank_num + '  ' + datum.player",
          "as": "right_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 10
      },
      "encoding": {
        "text": {
          "field": "right_label"
        },
        "color": {
          "value": "#1b1f24"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}