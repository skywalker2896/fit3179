{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Grouped bar chart of the four Australian Open semi-finalists each year, 2016-2025, for a selected stat (aces, double faults or break points saved) and a selected draw.",
  "data": {
    "url": "https://raw.githubusercontent.com/skywalker2896/fit3179/refs/heads/main/dataset/chart12.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "SelectedEvent",
      "value": "Men's Singles",
      "bind": {
        "input": "select",
        "options": [
          "Men's Singles",
          "Women's Singles"
        ],
        "name": "Draw: "
      }
    },
    {
      "name": "SelectedStat",
      "value": "Aces",
      "bind": {
        "input": "radio",
        "options": [
          "Aces",
          "Double faults",
          "Break points saved"
        ],
        "name": "Stat: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.event === SelectedEvent"
    },
    {
      "calculate": "toNumber(datum.year)",
      "as": "year"
    },
    {
      "filter": "datum.year >= 2016"
    },
    {
      "calculate": "SelectedStat === 'Aces' ? toNumber(datum.aces) : (SelectedStat === 'Double faults' ? toNumber(datum.double_faults) : toNumber(datum.bp_saved))",
      "as": "value"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "slot"
        }
      ],
      "groupby": [
        "year"
      ],
      "sort": [
        {
          "field": "result",
          "order": "descending"
        },
        {
          "field": "player",
          "order": "ascending"
        }
      ]
    }
  ],
  "width": "container",
  "height": 240,
  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 2,
    "cornerRadiusTopRight": 2,
    "stroke": "#ffffff",
    "strokeWidth": 1.5
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11
      }
    },
    "xOffset": {
      "field": "slot",
      "type": "nominal"
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": null,
      "axis": {
        "tickMinStep": 1
      }
    },
    "color": {
      "field": "result",
      "type": "nominal",
      "title": "Semi-final result",
      "scale": {
        "domain": [
          "Won semi-final",
          "Lost semi-final"
        ],
        "range": [
          "#0c2b5e",
          "#e6550d"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "player",
        "type": "nominal",
        "title": "Player"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "result",
        "type": "nominal",
        "title": "Result"
      },
      {
        "field": "value",
        "type": "quantitative",
        "title": "Selected stat"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 11,
      "titleFontSize": 13,
      "gridColor": "#e7e2d8"
    }
  }
}