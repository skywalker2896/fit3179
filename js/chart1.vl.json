
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/skywalker2896/fit3179/refs/heads/main/dataset/chart1.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.week)",
      "as": "week"
    },
    {
      "calculate": "toNumber(datum.matches)",
      "as": "matches"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2,
    "cornerRadius": 3
  },
  "width": 350,
  "height": 200,
  "encoding": {
    "x": {
      "field": "day",
      "type": "ordinal",
      "sort": [
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri",
        "Sat",
        "Sun"
      ],
      "title": "Day of week",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "week",
      "type": "ordinal",
      "title": "Tournament week",
      "axis": {
        "labelExpr": "'Week ' + datum.label"
      }
    },
    "color": {
      "field": "matches",
      "type": "quantitative",
      "title": "Matches played",
      "scale": {
        "scheme": "yelloworangered"
      }
    },
    "tooltip": [
      {
        "field": "date",
        "type": "temporal",
        "title": "Date",
        "format": "%a %d %b %Y"
      },
      {
        "field": "matches",
        "type": "quantitative",
        "title": "Matches played"
      },
      {
        "field": "rounds",
        "type": "nominal",
        "title": "Round(s)"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}