{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Winners win more of their first-serve points in every round",
    "subtitle": "First-serve points won (%) per player per match, Australian Open 2015–2026",
    "anchor": "start", "offset": 14
  },
  "data": {"url": "ao_first_serve_won.csv"},
  "width": 70,
  "height": 170,
  "spacing": 4,
  "transform": [
    {"density": "fs_won", "groupby": ["tour", "round", "result"], "bandwidth": 3, "extent": [30, 100], "steps": 71, "as": ["fs_won", "density"]}
  ],
  "mark": {"type": "area", "orient": "horizontal", "opacity": 0.85},
  "encoding": {
    "y": {"field": "fs_won", "type": "quantitative", "title": "First-serve points won (%)", "scale": {"domain": [30, 100]}, "axis": {"values": [40, 60, 80, 100]}},
    "x": {"field": "density", "type": "quantitative", "stack": "center", "impute": null, "title": null, "axis": {"labels": false, "values": [0], "grid": false, "ticks": false}},
    "color": {"field": "result", "type": "nominal", "title": "Match result", "scale": {"domain": ["Winner", "Loser"], "range": ["#2171b5", "#e6550d"]}, "legend": {"orient": "bottom", "direction": "horizontal"}},
    "column": {"field": "round", "type": "nominal", "title": "Round", "sort": ["R1", "R2", "R3", "R16", "QF", "SF", "F"], "header": {"titleOrient": "bottom", "labelOrient": "bottom", "labelPadding": 4}},
    "row": {"field": "tour", "type": "nominal", "title": null, "header": {"labelFontSize": 13, "labelOrient": "left", "labelAngle": -90}}
  },
  "config": {"view": {"stroke": null}, "axis": {"domain": false}}
}