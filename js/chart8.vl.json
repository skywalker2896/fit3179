{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Ranking Gap by Match (Australian Open 2026)",
    "fontSize": 14
  },
  "description": "Each dumbbell spans the two seeds contesting a match in the selected round. Line/end colour shows whether the higher-ranked (lower seed number) or lower-ranked (higher seed number) player won.",
  "data": {
    "url": "https://raw.githubusercontent.com/skywalker2896/fit3179/refs/heads/main/dataset/ao_2026.csv",
    "format": {"type": "csv"}
  },
  "params": [
    {
      "name": "SelectedRound",
      "value": "R16",
      "bind": {
        "input": "select",
        "options": [
          "R16",
          "QF",
          "SF",
          "F"
        ],
        "name": "Round: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.stage === 'Main Draw'"
    },
    {
      "filter": "datum.round === SelectedRound"
    },
    {
      "calculate": "isFinite(toNumber(datum.seed_1)) && datum.seed_1 !== '' ? toNumber(datum.seed_1) : 33",
      "as": "seed_1_num"
    },
    {
      "calculate": "isFinite(toNumber(datum.seed_2)) && datum.seed_2 !== '' ? toNumber(datum.seed_2) : 33",
      "as": "seed_2_num"
    },
    {
      "filter": "!(datum.seed_1_num === 33 && datum.seed_2_num === 33)"
    },
    {
      "calculate": "min(datum.seed_1_num, datum.seed_2_num)",
      "as": "higher_ranked_seed"
    },
    {
      "calculate": "max(datum.seed_1_num, datum.seed_2_num)",
      "as": "lower_ranked_seed"
    },
    {
      "calculate": "datum.seed_1_num < datum.seed_2_num ? datum.player_1 : datum.player_2",
      "as": "higher_ranked_player"
    },
    {
      "calculate": "datum.seed_1_num < datum.seed_2_num ? datum.player_2 : datum.player_1",
      "as": "lower_ranked_player"
    },
    {
      "calculate": "datum.winner === datum.higher_ranked_player ? 'Higher-ranked player won' : 'Lower-ranked player won'",
      "as": "result"
    },
    {
      "calculate": "datum.higher_ranked_player + ' vs ' + datum.lower_ranked_player",
      "as": "match_label"
    },
    {
      "calculate": "datum.lower_ranked_seed - datum.higher_ranked_seed",
      "as": "seed_diff"
    },
    {
      "calculate": "datum.higher_ranked_player + ' (' + (datum.higher_ranked_seed === 33 ? 'unseeded' : datum.higher_ranked_seed) + ')'",
      "as": "higher_label"
    },
    {
      "calculate": "datum.lower_ranked_player + ' (' + (datum.lower_ranked_seed === 33 ? 'unseeded' : datum.lower_ranked_seed) + ')'",
      "as": "lower_label"
    }
  ],
  "width": "container",
  "height": {
    "step": 34
  },
  "encoding": {
    "y": {
      "field": "match_label",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "seed_diff",
        "order": "descending"
      },
      "axis": {
        "labels": false,
        "ticks": false,
        "title": null,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "higher_ranked_seed",
          "type": "quantitative",
          "title": "Seed (rank)",
          "axis": {
            "title": "Seed (rank) \u2014 33 = unseeded",
            "values": [
              1,
              5,
              10,
              15,
              20,
              25,
              30,
              33
            ],
            "labelExpr": "datum.value === 33 ? 'U' : datum.label"
          }
        },
        "x2": {
          "field": "lower_ranked_seed"
        },
        "color": {
          "field": "result",
          "type": "nominal",
          "title": "Match outcome",
          "scale": {
            "domain": [
              "Higher-ranked player won",
              "Lower-ranked player won"
            ],
            "range": [
              "#1f77b4",
              "#d62728"
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110,
        "shape": "circle"
      },
      "encoding": {
        "x": {
          "field": "higher_ranked_seed",
          "type": "quantitative"
        },
        "color": {
          "value": "#444444"
        },
        "tooltip": [
          {
            "field": "higher_ranked_player",
            "type": "nominal",
            "title": "Higher-ranked player"
          },
          {
            "field": "higher_ranked_seed",
            "type": "quantitative",
            "title": "Seed"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110,
        "shape": "circle"
      },
      "encoding": {
        "x": {
          "field": "lower_ranked_seed",
          "type": "quantitative"
        },
        "color": {
          "value": "#444444"
        },
        "tooltip": [
          {
            "field": "lower_ranked_player",
            "type": "nominal",
            "title": "Lower-ranked player"
          },
          {
            "field": "lower_ranked_seed",
            "type": "quantitative",
            "title": "Seed"
          },
          {
            "field": "result",
            "type": "nominal",
            "title": "Outcome"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -9,
        "fontSize": 10
      },
      "encoding": {
        "x": {
          "field": "higher_ranked_seed",
          "type": "quantitative"
        },
        "text": {
          "field": "higher_label",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 10
      },
      "encoding": {
        "x": {
          "field": "lower_ranked_seed",
          "type": "quantitative"
        },
        "text": {
          "field": "lower_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 13
    },
    "title": {
      "fontSize": 16
    },
    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "titleFontSize": 11,
      "labelFontSize": 11
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": {
    "left": 150,
    "right": 150,
    "top": 5,
    "bottom": 5
  }
}