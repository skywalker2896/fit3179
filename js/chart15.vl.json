{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Cumulative number of different nationalities and different players to appear in the Australian Open main draws, 2000-2025.",
  "data": {
    "url": "https://raw.githubusercontent.com/skywalker2896/fit3179/refs/heads/main/dataset/chart15.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.year)",
      "as": "year"
    },
    {
      "calculate": "toNumber(datum.nationalities)",
      "as": "nationalities"
    },
    {
      "calculate": "toNumber(datum.players)",
      "as": "players"
    },
    {
      "calculate": "toNumber(datum.nations_in_year)",
      "as": "nations_in_year"
    },
    {
      "calculate": "toNumber(datum.players_in_year)",
      "as": "players_in_year"
    }
  ],
  "vconcat": [
    {
      "title": {
        "text": "Different nationalities (cumulative)",
        "anchor": "start",
        "fontSize": 12
      },
      "width": 440,
      "height": 150,
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#0c2b5e",
            "strokeWidth": 2.5,
            "point": {
              "filled": true,
              "size": 40,
              "color": "#0c2b5e"
            }
          },
          "encoding": {
            "tooltip": [
              {
                "field": "year",
                "type": "ordinal",
                "title": "Year"
              },
              {
                "field": "nationalities",
                "type": "quantitative",
                "title": "Countries so far"
              },
              {
                "field": "nations_in_year",
                "type": "quantitative",
                "title": "Countries that year"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year === 2025"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "fontWeight": "bold",
            "fontSize": 13,
            "color": "#0c2b5e"
          },
          "encoding": {
            "text": {
              "field": "nationalities",
              "type": "quantitative",
              "format": ",d"
            }
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1999.5,
              2025.5
            ]
          },
          "axis": {
            "format": "d",
            "values": [
              2000,
              2005,
              2010,
              2015,
              2020,
              2025
            ],
            "labels": false,
            "grid": false
          }
        },
        "y": {
          "field": "nationalities",
          "type": "quantitative",
          "title": "Countries",
          "scale": {
            "domain": [
              0,
              90
            ]
          },
          "axis": {
            "values": [
              0,
              30,
              60,
              90
            ],
            "format": ",d",
            "labelOverlap": false
          }
        }
      }
    },
    {
      "title": {
        "text": "Different players (cumulative)",
        "anchor": "start",
        "fontSize": 12
      },
      "width": 440,
      "height": 150,
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#e6550d",
            "strokeWidth": 2.5,
            "point": {
              "filled": true,
              "size": 40,
              "color": "#e6550d"
            }
          },
          "encoding": {
            "tooltip": [
              {
                "field": "year",
                "type": "ordinal",
                "title": "Year"
              },
              {
                "field": "players",
                "type": "quantitative",
                "title": "Players so far",
                "format": ","
              },
              {
                "field": "players_in_year",
                "type": "quantitative",
                "title": "Players that year"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year === 2025"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "fontWeight": "bold",
            "fontSize": 13,
            "color": "#e6550d"
          },
          "encoding": {
            "text": {
              "field": "players",
              "type": "quantitative",
              "format": ",d"
            }
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Year",
          "scale": {
            "domain": [
              1999.5,
              2025.5
            ]
          },
          "axis": {
            "format": "d",
            "values": [
              2000,
              2005,
              2010,
              2015,
              2020,
              2025
            ],
            "labels": true,
            "grid": false
          }
        },
        "y": {
          "field": "players",
          "type": "quantitative",
          "title": "Players",
          "scale": {
            "domain": [
              0,
              1600
            ]
          },
          "axis": {
            "values": [
              0,
              400,
              800,
              1200,
              1600
            ],
            "format": ",d",
            "labelOverlap": false
          }
        }
      }
    }
  ],
  "spacing": 14,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "gridColor": "#e7e2d8",
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}